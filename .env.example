# Gemini API key from Google AI Studio. Keep the real value in .env only.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: set to true to avoid Gemini requests while testing the UI.
DEMO_MODE=false

# Phone pairing. Use the PC LAN IP with HTTPS (or an HTTPS tunnel such as ngrok).
# PAIR_HOST=192.168.1.100
# PAIR_SCHEME=https
# PAIR_PORT=443
