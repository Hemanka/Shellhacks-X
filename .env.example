# Gemini API key from Google AI Studio. Keep the real value in .env only.
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API key. It stays on the server and is never sent to the browser.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional ElevenLabs overrides. These defaults favor low-latency navigation prompts.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STT_MODEL_ID=scribe_v2

# Optional: set to true to avoid Gemini requests while testing the UI.
DEMO_MODE=false

# Phone pairing. Use the PC LAN IP with HTTPS (or an HTTPS tunnel such as ngrok).
# PAIR_BASE_URL=https://your-host.example
# PAIR_HOST=192.168.1.100
# PAIR_SCHEME=https
# PAIR_PORT=443
